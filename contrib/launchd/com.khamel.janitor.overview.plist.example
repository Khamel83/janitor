<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!--
Template. Copy to ~/Library/LaunchAgents/com.khamel.janitor.overview.plist
and replace every REPLACE_ME placeholder before loading. See
contrib/launchd/README.md for the full setup.
-->
<plist version="1.0">
<dict>
    <key>Label</key>
    <string>com.khamel.janitor.overview</string>
    <key>ProgramArguments</key>
    <array>
        <string>REPLACE_ME_JANITOR_BIN</string>
        <string>overview</string>
        <string>REPLACE_ME_REPO_1</string>
        <string>REPLACE_ME_REPO_2</string>
    </array>
    <key>EnvironmentVariables</key>
    <dict>
        <key>PATH</key>
        <string>/usr/local/bin:/usr/bin:/bin:/usr/sbin:/sbin:REPLACE_ME_HOME/bin:REPLACE_ME_HOME/.local/bin</string>
        <key>HOME</key>
        <string>REPLACE_ME_HOME</string>
        <key>JANITOR_DOCS_MIRROR</key>
        <string>REPLACE_ME_DOCS_MIRROR_PATH</string>
    </dict>
    <key>StartCalendarInterval</key>
    <dict>
        <key>Weekday</key>
        <integer>7</integer>
        <key>Hour</key>
        <integer>4</integer>
        <key>Minute</key>
        <integer>0</integer>
    </dict>
    <key>StandardOutPath</key>
    <string>REPLACE_ME_HOME/Library/Logs/janitor-overview.log</string>
    <key>StandardErrorPath</key>
    <string>REPLACE_ME_HOME/Library/Logs/janitor-overview.err</string>
</dict>
</plist>
