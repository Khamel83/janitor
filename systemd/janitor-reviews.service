[Unit]
Description=Janitor morning PR review evidence packet
After=network-online.target tailscaled.service
Wants=network-online.target
StartLimitIntervalSec=2h
StartLimitBurst=3

[Service]
Type=oneshot
ExecStart=/usr/bin/ssh -o BatchMode=yes -o ConnectTimeout=10 -o ServerAliveInterval=15 -o ServerAliveCountMax=3 macmini "caffeinate -is /Users/macmini/.local/bin/janitor-runner reviews --all"
TimeoutStartSec=55min
TimeoutStopSec=30
Restart=on-failure
RestartSec=10min
StandardOutput=journal
StandardError=journal
